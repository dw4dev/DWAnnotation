<Window x:Class="FloatingAnnotationTool.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OverlayWindow"
        Icon="/Assets/Icons/AppIcon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        PreviewKeyDown="OverlayWindow_PreviewKeyDown">
    
    <Grid Background="#01000000">
        <!-- Ink Canvas (for all drawings) -->
        <InkCanvas x:Name="DrawingCanvas"
                   Background="#01000000"
                   EditingMode="Ink"
                   MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                   MouseMove="DrawingCanvas_MouseMove"
                   MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp">
            <InkCanvas.DefaultDrawingAttributes>
                <DrawingAttributes Width="3" Height="3" Color="Blue"/>
            </InkCanvas.DefaultDrawingAttributes>
        </InkCanvas>
    </Grid>
</Window>
