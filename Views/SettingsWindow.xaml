<Window x:Class="FloatingAnnotationTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定" 
        Height="450" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel>
                <!-- Magic Pen Settings -->
                <TextBlock Text="🎨 魔術筆設定" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" 
                        CornerRadius="6" 
                        Padding="15"
                        Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" 
                                        ShadowDepth="2" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="淡出時間 (毫秒):" Style="{StaticResource LabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FadeDurationSlider"
                                    Grid.Column="0"
                                    Minimum="200"
                                    Maximum="3000"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding ElementName=FadeDurationSlider, Path=Value, StringFormat={}{0:F0} ms}"
                                      FontWeight="SemiBold"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      MinWidth="70"
                                      TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Color Settings -->
                <TextBlock Text="🎨 顏色設定" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" 
                        CornerRadius="6" 
                        Padding="15"
                        Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" 
                                        ShadowDepth="2" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="主色:" Style="{StaticResource LabelStyle}"/>
                        <Button x:Name="PrimaryColorBtn"
                                Click="PrimaryColorBtn_Click"
                                Height="40"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="4" 
                                            BorderBrush="#D0D0D0" 
                                            BorderThickness="2">
                                        <Border.Background>
                                            <SolidColorBrush x:Name="PrimaryColorBrush" Color="#0078D4"/>
                                        </Border.Background>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="副色:" Style="{StaticResource LabelStyle}"/>
                        <Button x:Name="SecondaryColorBtn"
                                Click="SecondaryColorBtn_Click"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="4" 
                                            BorderBrush="#D0D0D0" 
                                            BorderThickness="2">
                                        <Border.Background>
                                            <SolidColorBrush x:Name="SecondaryColorBrush" Color="#FF6B6B"/>
                                        </Border.Background>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Pen Settings -->
                <TextBlock Text="✏️ 筆刷設定" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="White" 
                        CornerRadius="6" 
                        Padding="15"
                        Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" 
                                        ShadowDepth="2" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="筆寬:" Style="{StaticResource LabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PenWidthSlider"
                                    Grid.Column="0"
                                    Minimum="1"
                                    Maximum="40"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding ElementName=PenWidthSlider, Path=Value, StringFormat={}{0:F0} px}"
                                      FontWeight="SemiBold"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      MinWidth="60"
                                      TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="橡皮擦大小:" Style="{StaticResource LabelStyle}" Margin="0,15,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="EraserSizeSlider"
                                    Grid.Column="0"
                                    Minimum="5"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding ElementName=EraserSizeSlider, Path=Value, StringFormat={}{0:F0} px}"
                                      FontWeight="SemiBold"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      MinWidth="60"
                                      TextAlignment="Right"/>
                        </Grid>

                        <CheckBox x:Name="GradientEnabledCheckBox"
                                  Content="啟用漸層"
                                  Margin="0,15,0,0"
                                  FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="儲存"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="SaveBtn_Click"
                    MinWidth="100"/>

            <Button Grid.Column="3"
                    Content="取消"
                    Style="{StaticResource CancelButtonStyle}"
                    Click="CancelBtn_Click"
                    MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
