<Window
    x:Class="FloatingAnnotationTool.Views.MainToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Floating Toolbar"
    Width="640"
    Height="50"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Assets/Icons/AppIcon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#505050" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="WhiteSmoke" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#505050" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0078D4" />
                                <Setter Property="BorderBrush" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Icon Style  -->
        <Style TargetType="fa:IconImage">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border
            Background="White"
            BorderBrush="#D0D0D0"
            BorderThickness="1.5"
            CornerRadius="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            SnapsToDevicePixels="True">

            <StackPanel
                Margin="10,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!--  Cursor / View Mode  -->
                <ToggleButton
                    x:Name="CursorBtn"
                    Click="CursorBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="滑鼠游標 (退出編輯模式)">
                    <fa:IconImage Margin="3,0,0,0" Icon="MousePointer" />
                </ToggleButton>

                <Separator
                    Width="1"
                    Margin="4,4"
                    Background="#E0E0E0" />

                <!--  Pen Tool  -->
                <ToggleButton
                    x:Name="PenBtn"
                    Click="PenBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="手繪筆">
                    <fa:IconImage Icon="Pen" />
                </ToggleButton>

                <!--  Line Tool  -->
                <ToggleButton
                    x:Name="LineBtn"
                    Click="LineBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="直線">
                    <fa:IconImage Icon="Slash" RenderTransformOrigin="0.5,0.5">
                        <fa:IconImage.RenderTransform>
                            <RotateTransform Angle="-45" />
                        </fa:IconImage.RenderTransform>
                    </fa:IconImage>
                </ToggleButton>

                <!--  Rectangle Tool  -->
                <ToggleButton
                    x:Name="RectangleBtn"
                    Click="RectangleBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="矩形">
                    <fa:IconImage Icon="Square" />
                </ToggleButton>

                <!--  Eraser Point Tool (Arbitrary)  -->
                <ToggleButton
                    x:Name="EraserPointBtn"
                    Click="EraserPointBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="橡皮擦 (軌跡擦除)">
                    <fa:IconImage Icon="Eraser" />
                </ToggleButton>

                <!--  Eraser Object Tool (Whole Object)  -->
                <ToggleButton
                    x:Name="EraserObjectBtn"
                    Click="EraserObjectBtn_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="橡皮擦 (物件擦除)">
                    <fa:IconImage Icon="RectangleXmark" />
                </ToggleButton>

                <Separator
                    Width="1"
                    Margin="4,4"
                    Background="#E0E0E0" />

                <!--  Primary Color  -->
                <Button
                    x:Name="PrimaryColorBtn"
                    Click="PrimaryColorBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="主色選擇">
                    <Border
                        Width="18"
                        Height="18"
                        BorderBrush="#808080"
                        BorderThickness="1"
                        CornerRadius="9">
                        <Border.Background>
                            <SolidColorBrush x:Name="PrimaryColorBrush" Color="#0078D4" />
                        </Border.Background>
                    </Border>
                </Button>

                <!--  Secondary Color  -->
                <Button
                    x:Name="SecondaryColorBtn"
                    Click="SecondaryColorBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="副色選擇">
                    <Border
                        Width="18"
                        Height="18"
                        BorderBrush="#808080"
                        BorderThickness="1"
                        CornerRadius="9">
                        <Border.Background>
                            <SolidColorBrush x:Name="SecondaryColorBrush" Color="#FF6B6B" />
                        </Border.Background>
                    </Border>
                </Button>

                <Separator
                    Width="1"
                    Margin="4,4"
                    Background="#E0E0E0" />

                <!--  Gradient Toggle  -->
                <ToggleButton
                    x:Name="GradientBtn"
                    Click="GradientBtn_Click"
                    IsChecked="{Binding GradientEnabled, Mode=TwoWay}"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="漸層模式">
                    <fa:IconImage Icon="Palette" />
                </ToggleButton>

                <!--  Magic Pen Toggle  -->
                <ToggleButton
                    x:Name="MagicPenBtn"
                    Click="MagicPenBtn_Click"
                    IsChecked="{Binding MagicPenEnabled, Mode=TwoWay}"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="魔術筆模式">
                    <fa:IconImage Icon="Magic" />
                </ToggleButton>

                <Separator
                    Width="1"
                    Margin="4,4"
                    Background="#E0E0E0" />

                <!--  Undo  -->
                <Button
                    x:Name="UndoBtn"
                    Click="UndoBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="復原">
                    <fa:IconImage Icon="Undo" />
                </Button>

                <!--  Save to PNG  -->
                <Button
                    x:Name="SaveBtn"
                    Click="SaveBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="儲存為 PNG (Ctrl+S)">
                    <fa:IconImage Icon="FloppyDisk" />
                </Button>

                <!--  Copy to Clipboard  -->
                <Button
                    x:Name="CopyBtn"
                    Click="CopyBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="複製到剪貼簿 (Ctrl+C)">
                    <fa:IconImage Icon="Copy" />
                </Button>

                <!--  Clear All  -->
                <Button
                    x:Name="ClearBtn"
                    Click="ClearBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="清除全部">
                    <fa:IconImage Icon="Trash" />
                </Button>

                <Separator
                    Width="1"
                    Margin="4,4"
                    Background="#E0E0E0" />

                <!--  Settings  -->
                <Button
                    x:Name="SettingsBtn"
                    Click="SettingsBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="設定">
                    <fa:IconImage Icon="Cog" />
                </Button>

                <!--  Minimize  -->
                <Button
                    x:Name="MinimizeBtn"
                    Click="MinimizeBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="最小化">
                    <fa:IconImage Icon="WindowMinimize" />
                </Button>

                <!--  Exit  -->
                <Button
                    x:Name="ExitBtn"
                    Click="ExitBtn_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="結束">
                    <fa:IconImage Icon="Times" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
